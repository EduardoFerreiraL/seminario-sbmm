#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -f "$SCRIPT_DIR/.venv/Scripts/python.exe" ]; then
    "$SCRIPT_DIR/.venv/Scripts/python.exe" "$SCRIPT_DIR/dev.py" "$@"
elif [ -f "$SCRIPT_DIR/.venv/bin/python" ]; then
    "$SCRIPT_DIR/.venv/bin/python" "$SCRIPT_DIR/dev.py" "$@"
else
    python "$SCRIPT_DIR/dev.py" "$@"
fi

